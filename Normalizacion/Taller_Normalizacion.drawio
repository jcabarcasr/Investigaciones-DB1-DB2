          <mxGeometry height="40" width="120" x="790" y="980" as="geometry" />
        </mxCell>
        <mxCell id="Fia_0RmaFBbEIdyI5jC9-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Una especialidad puede ocupar consultorios en varios pisos. Solo sería válida si el negocio impone que cada especialidad está centralizada en un único piso." vertex="1">
          <mxGeometry height="70" width="260" x="600" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="Fia_0RmaFBbEIdyI5jC9-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Cumple con 1FN, 2FN y 3FN?" vertex="1">
          <mxGeometry height="50" width="200" x="1060" y="390" as="geometry" />
        </mxCell>
        <mxCell id="Fia_0RmaFBbEIdyI5jC9-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1FN&amp;nbsp;&lt;div&gt;Sí está en 1FN si todos los atributos son atómicos. Si Diagnóstico o Tratamiento_Recomendado pudieran contener varios valores en un mismo campo, no estaría en 1FN.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="1071" y="470" as="geometry" />
        </mxCell>
        <mxCell id="Fia_0RmaFBbEIdyI5jC9-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="2FN&amp;nbsp;&lt;div&gt;Si esta en 2FN ya que no contiene alguna clave compuesta y no tiene alguna diferencia parcial con un atributo no primo&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="1071" y="580" as="geometry" />
        </mxCell>
        <mxCell id="Fia_0RmaFBbEIdyI5jC9-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="3FN&amp;nbsp;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;No cumple 3FN porque hay dependencias transitivas:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;ID_Cita → ID_Paciente → Nombre_Paciente, Teléfono_Paciente&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;ID_Cita → ID_Doctor → Nombre_Doctor, Especialidad_Doctor&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;ID_Cita → Consultorio_Asignado → Piso_Consultorio&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Si ID_Doctor → Consultorio_Asignado, entonces:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;ID_Cita → ID_Doctor → Consultorio_Asignado → Piso_Consultorio&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Si Especialidad_Doctor → Piso_Consultorio, entonces:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;ID_Cita → ID_Doctor → Especialidad_Doctor → Piso_Consultorio&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Conclusión:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Con ID_Cita como clave simple, el esquema está en 2FN pero no en 3FN.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Si se usa una clave compuesta, podría ni siquiera estar en 2FN.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="205" width="340" x="1016" y="750" as="geometry" />
        </mxCell>
