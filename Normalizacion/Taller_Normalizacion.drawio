        <mxCell id="Fia_0RmaFBbEIdyI5jC9-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Si el negocio define que un doctor esta asigando a un solo consultorio, este tambien depende del mismo. Si no, un doctor puede atender en varios consultorios distintos" vertex="1">
